Options -Indexes

# Project notes (CLAUDE.md and other .md files) live in the repo, never on the public site
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>

# Client photos are permanently gone from the public site: 410 tells search engines to drop them.
# Do not block these paths in robots.txt, or Google cannot see the 410.
RewriteEngine On
RewriteRule ^assets/images/satisfiedclients(/|$) - [G,L,NC]
RewriteRule ^assets/images\.zip$ - [G,L,NC]
RewriteRule ^assets/js/clients-gallery\.json$ - [G,L,NC]

# Force www redirect
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Pretty URLs - serve index.html for directory paths
DirectoryIndex index.html

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>
